{
  "name": "ong-maos-solidarias",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "description": "Site da ONG Mãos Solidárias (SPA em HTML, CSS e JavaScript puro).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node ferramentas/servidor.js",
    "build": "node ferramentas/build.js",
    "preview": "node ferramentas/servidor.js dist",
    "build:vendor": "esbuild ferramentas/chart-entrada.js --bundle --format=esm --minify --legal-comments=eof --outfile=js/vendor/chart.esm.js",
    "imagens": "node ferramentas/imagens.js",
    "test": "node --test",
    "test:e2e": "playwright test --project=desenvolvimento",
    "test:e2e:producao": "npm run build && playwright test --project=producao",
    "contraste": "node ferramentas/contraste.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.0",
    "chart.js": "4.5.1",
    "esbuild": "0.28.2",
    "html-minifier-terser": "7.2.0",
    "sharp": "0.35.5"
  }
}
